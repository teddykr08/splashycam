{% comment %}
  Section contract.
  Splashy Cam's simple header: the logo (or a labeled placeholder) and one Buy button.
  Replaces Horizon's header, menu and announcement bar in the header group.
  @example
  <!-- Header group > Splashy header. Logo comes from Theme settings > Logo. -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

{%- liquid
  if section.settings.buy_product != blank
    assign buy_url = section.settings.buy_product.url
  elsif section.settings.buy_link != blank
    assign buy_url = section.settings.buy_link
  else
    assign buy_url = routes.all_products_collection_url
  endif
-%}

<div class="sc-header{% if section.settings.sticky %} sc-header--sticky{% endif %}">
  <div class="sc-header__inner">
    <a class="sc-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag:
            alt: shop.name,
            height: settings.logo_height_mobile,
            widths: '200, 300, 400',
            sizes: '200px',
            class: 'sc-header__logo-img',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <span class="sc-header__logo-placeholder">
          {% render 'splashy-placeholder', label: 'Your logo', hint: 'Theme settings > Logo' %}
        </span>
        <span class="visually-hidden">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <a class="sc-btn" href="{{ buy_url }}">{{ section.settings.buy_label | escape }}</a>
  </div>
</div>

{% stylesheet %}
  .sc-header {
    padding: 12px 16px;
    border-block-end: var(--sc-outline) solid var(--sc-ink);
    background: var(--sc-sky);
  }

  .sc-header--sticky {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
  }

  .sc-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1080px;
    margin-inline: auto;
  }

  .sc-header__logo {
    display: block;
    min-width: 0;
    color: inherit;
  }

  .sc-header__logo-img {
    display: block;
    width: auto;
    height: 40px;
  }

  .sc-header__logo-placeholder .sc-placeholder {
    min-height: 0;
    width: 140px;
    height: 44px;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.875rem;
    line-height: 1.1;
  }

  .sc-header__logo-placeholder .sc-placeholder small {
    font-size: 0.65rem;
  }

  .sc-header .sc-btn {
    min-height: 44px;
    padding-inline: 22px;
    flex-shrink: 0;
  }

  @media (min-width: 750px) {
    .sc-header {
      padding-block: 16px;
    }

    .sc-header__logo-img {
      height: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy header",
  "class": "sc-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Upload the logo under Theme settings > Logo. Until then a labeled placeholder shows."
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Buy button text",
      "default": "Buy"
    },
    {
      "type": "product",
      "id": "buy_product",
      "label": "Buy button product"
    },
    {
      "type": "url",
      "id": "buy_link",
      "label": "Or link the Buy button somewhere else",
      "info": "Used only when no product is picked. Without either, it goes to all products."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top while scrolling",
      "default": true
    }
  ]
}
{% endschema %}
