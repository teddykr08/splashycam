{% comment %}
  Section contract.
  FAQ: each question is a block, rendered as a native <details> disclosure so it
  works with the keyboard and without JavaScript.
  @example
  <!-- Home page > Splashy FAQ, with Question blocks -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

<div class="sc-section sc-faq">
  <div class="sc-wrap sc-faq__wrap">
    <h2 class="sc-title sc-faq__title">{{ section.settings.heading | escape }}</h2>

    <div class="sc-faq__list">
      {%- for block in section.blocks -%}
        <details class="sc-card sc-faq__item" {{ block.shopify_attributes }}>
          <summary class="sc-faq__q">{{ block.settings.question | escape }}</summary>
          <div class="sc-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sc-faq {
    background: var(--sc-sky);
    border-block-start: var(--sc-outline) solid var(--sc-ink);
  }

  .sc-faq__wrap {
    max-width: 760px;
  }

  .sc-faq__title {
    text-align: center;
  }

  .sc-faq__list {
    display: grid;
    gap: 16px;
    margin-block-start: 28px;
  }

  .sc-faq__item {
    padding: 0;
  }

  .sc-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 20px;
    cursor: pointer;
    font-family: var(--sc-display);
    font-size: 1.125rem;
    font-weight: 600;
    list-style: none;
  }

  .sc-faq__q::-webkit-details-marker {
    display: none;
  }

  .sc-faq__q::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 50%;
    background: var(--sc-orange);
    font-size: 1.25rem;
    line-height: 1;
    transition: rotate 0.2s ease;
  }

  .sc-faq__item[open] .sc-faq__q::after {
    rotate: 45deg;
  }

  .sc-faq__q:focus-visible {
    outline: 3px solid var(--sc-ink);
    outline-offset: -6px;
    border-radius: var(--sc-radius);
  }

  .sc-faq__a {
    padding: 0 20px 18px;
    line-height: 1.5;
  }

  .sc-faq__a p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-faq__q::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy FAQ",
  "class": "sc-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions?"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splashy FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How does it work?",
            "answer": "<p>Tighten the mount onto your gun once and leave it there. Drop your phone in, open the free Splashy Cam app and play. It films your target and you, and stamps the time on every clip.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I save 10%?",
            "answer": "<p>Order with your school’s link and pick “School box”. Everyone who orders on that link goes in one box. If your school’s box gets to 5 orders, you get another 5% back automatically.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "When will it ship?",
            "answer": "<p>A school box ships the day after it reaches 5 orders, or at its deadline: 5 days before your game starts, or 3 days after the box opens once the game is on. It always ships, even if it doesn’t fill.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I get mine sooner?",
            "answer": "<p>Pick “Ship to me” and it ships right away for $21. Or, in a school box, tick “Ship mine alone if my box isn’t full in 3 days” and it ships on its own after 3 days at the same price.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Buying for friends?",
            "answer": "<p>Get 2, 3 or 4 in one order and save 10, 15 or 20%. That stacks with the school box discount.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Running your school’s game?",
            "answer": "<p>Become a host. You get a link for your school and earn on every order that uses it. Get in touch with us to set it up.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
