{
  "expo": {
    "name": "Splashy Cam",
    "slug": "splashycam",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "splashycam",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "txt.teddy.splashycam",
      "infoPlist": {
        "NSLocationDefaultAccuracyReduced": true
      }
    },
    "android": {
      "package": "txt.teddy.splashycam",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Splashy Cam records your eliminations.",
          "microphonePermission": "Splashy Cam records audio with your clips.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Splashy Cam stamps the city (never your exact address) on a clip so hosts can verify it.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Splashy Cam saves your clips to your camera roll.",
          "granularPermissions": []
        }
      ],
      "expo-asset",
      "expo-video"
    ]
  }
}
