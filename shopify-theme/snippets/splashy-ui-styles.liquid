{% doc %}
  Shared CSS for the splashy-* sections: layout wrappers, cards, buttons, kicker
  labels and labeled placeholders. Each splashy section renders this; Shopify
  includes the stylesheet once per page. Colors and sizes come from the --sc-*
  properties set by splashy-styles.

  @example
  {% render splashy-ui-styles %}
{% enddoc %}

{% stylesheet %}
  .sc-section {
    padding-block: clamp(48px, 9vw, 96px);
    padding-inline: 16px;
  }

  .sc-wrap {
    max-width: 1080px;
    margin-inline: auto;
  }

  .sc-kicker {
    display: inline-block;
    margin: 0 0 12px;
    padding: 4px 14px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 999px;
    background: var(--sc-orange);
    color: var(--sc-ink);
    font-family: var(--sc-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sc-title {
    margin: 0 0 16px;
    font-family: var(--sc-display);
    font-size: clamp(2rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    text-wrap: balance;
  }

  .sc-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .sc-card {
    min-width: 0;
    padding: 24px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: var(--sc-radius);
    background: #fff;
    box-shadow: var(--sc-shadow) var(--sc-shadow) 0 var(--sc-ink);
  }

  .sc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 28px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 999px;
    background: var(--sc-orange);
    color: var(--sc-ink);
    box-shadow: var(--sc-shadow) var(--sc-shadow) 0 var(--sc-ink);
    font-family: var(--sc-display);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .sc-btn--sky {
    background: var(--sc-sky);
  }

  .sc-btn:focus-visible,
  .sc-card:focus-visible {
    outline: 3px solid var(--sc-sky);
    outline-offset: 4px;
  }

  .sc-btn:active,
  :is(.button, .button-secondary):not(.button-unstyled):active {
    transform: translate(var(--sc-shadow), var(--sc-shadow));
    box-shadow: 0 0 0 var(--sc-ink);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sc-btn:hover,
    .sc-bounce:hover,
    :is(.button, .button-secondary):not(.button-unstyled):hover {
      transform: translate(var(--sc-lift), var(--sc-lift));
      box-shadow: calc(var(--sc-shadow) - var(--sc-lift)) calc(var(--sc-shadow) - var(--sc-lift)) 0 var(--sc-ink);
    }

    .sc-bounce {
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-btn,
    .sc-bounce,
    :is(.button, .button-secondary):not(.button-unstyled) {
      transition: none;
    }
  }

  /* Form fields for the splashy forms (launch signup, host application). */
  .sc-field {
    width: 100%;
    min-height: 52px;
    padding: 10px 18px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 16px;
    background: #fff;
    color: var(--sc-ink);
    font: inherit;
    font-size: 1.0625rem;
  }

  .sc-field:focus-visible {
    outline: 3px solid var(--sc-sky);
    outline-offset: 2px;
  }

  .sc-field[aria-invalid='true'] {
    border-color: #c62828;
  }

  .sc-form-error {
    margin: 0;
    color: #b71c1c;
    font-weight: 600;
  }

  /* A labeled stand-in for a logo, illustration or video until a real one is picked. */
  .sc-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 120px;
    padding: 12px;
    border: var(--sc-outline) dashed var(--sc-ink);
    border-radius: var(--sc-radius);
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--sc-sky) 18%, #fff),
      color-mix(in srgb, var(--sc-sky) 18%, #fff) 12px,
      #fff 12px,
      #fff 24px
    );
    color: var(--sc-ink);
    font-family: var(--sc-display);
    font-weight: 600;
    text-align: center;
  }

  .sc-placeholder small {
    display: block;
    font-family: inherit;
    font-weight: 500;
    opacity: 0.7;
  }
{% endstylesheet %}
