{% comment %}
  Section contract.
  FAQ: each question is a block, rendered as a native <details> disclosure so it
  works with the keyboard and without JavaScript.
  @example
  <!-- Home page > Splashy FAQ, with Question blocks -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

<div class="sc-section sc-faq">
  <div class="sc-wrap sc-faq__wrap">
    <h2 class="sc-title sc-faq__title">{{ section.settings.heading | escape }}</h2>

    <div class="sc-faq__list">
      {%- for block in section.blocks -%}
        <details class="sc-card sc-faq__item" {{ block.shopify_attributes }}>
          <summary class="sc-faq__q">{{ block.settings.question | escape }}</summary>
          <div class="sc-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .sc-faq {
    background: var(--sc-sky);
    border-block-start: var(--sc-outline) solid var(--sc-ink);
  }

  .sc-faq__wrap {
    max-width: 760px;
  }

  .sc-faq__title {
    text-align: center;
  }

  .sc-faq__list {
    display: grid;
    gap: 16px;
    margin-block-start: 28px;
  }

  .sc-faq__item {
    padding: 0;
  }

  .sc-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 20px;
    cursor: pointer;
    font-family: var(--sc-display);
    font-size: 1.125rem;
    font-weight: 600;
    list-style: none;
  }

  .sc-faq__q::-webkit-details-marker {
    display: none;
  }

  .sc-faq__q::after {
    content: '+';
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 50%;
    background: var(--sc-orange);
    font-size: 1.25rem;
    line-height: 1;
    transition: rotate 0.2s ease;
  }

  .sc-faq__item[open] .sc-faq__q::after {
    rotate: 45deg;
  }

  .sc-faq__q:focus-visible {
    outline: 3px solid var(--sc-ink);
    outline-offset: -6px;
    border-radius: var(--sc-radius);
  }

  .sc-faq__a {
    padding: 0 20px 18px;
    line-height: 1.5;
  }

  .sc-faq__a p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-faq__q::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy FAQ",
  "class": "sc-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions?"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splashy FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Does it come assembled?",
            "answer": "<p>Yes. It arrives ready to go. Just tighten it onto your gun and put your phone in.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do I need the app?",
            "answer": "<p>The Splashy Cam app is free and separate. Scan the QR code in the box to download it.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I leave it on my gun?",
            "answer": "<p>Yes, that’s the idea. Leave it on and setup is just dropping your phone in.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What does the app add to my clips?",
            "answer": "<p>A stamp with the time, a code and your city, plus a proof card you can send to your host.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do group orders work?",
            "answer": "<p>Order on your school host’s link and your order joins their box. The more orders in the box, the less everyone pays. See the options on the product page.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
