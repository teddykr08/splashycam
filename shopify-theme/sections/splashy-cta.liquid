{% comment %}
  Section contract.
  A closing call to action: short heading, the price and the Buy button again.
  @example
  <!-- Home page > Splashy buy again, after the benefits -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

{%- liquid
  if section.settings.button_product != blank
    assign button_url = section.settings.button_product.url
  elsif section.settings.button_link != blank
    assign button_url = section.settings.button_link
  else
    assign button_url = routes.all_products_collection_url
  endif
-%}

<div class="sc-section sc-cta">
  <div class="sc-wrap sc-cta__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="sc-title sc-cta__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="sc-btn sc-cta__btn" href="{{ button_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <p class="sc-cta__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sc-cta__wrap {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }

  .sc-cta__title {
    margin: 0;
  }

  .sc-cta__btn {
    width: min(100%, 360px);
    min-height: 60px;
    font-size: 1.375rem;
  }

  .sc-cta__note {
    margin: 0;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy buy again",
  "class": "sc-cta-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for game day?" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Get the mount · $21" },
    { "type": "product", "id": "button_product", "label": "Button product" },
    {
      "type": "url",
      "id": "button_link",
      "label": "Or link the button somewhere else",
      "info": "Used only when no product is picked."
    },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "Shipping included" }
  ],
  "presets": [{ "name": "Splashy buy again" }]
}
{% endschema %}
