{% comment %}
  Section contract.
  "How it works": numbered step cards, each with an illustration slot (or a labeled
  placeholder), a title and a line of text. Steps are blocks, so they can be
  reordered, added or removed.
  @example
  <!-- Home page > Splashy how it works, with three Step blocks -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

<div class="sc-section sc-steps">
  <div class="sc-wrap">
    <h2 class="sc-title sc-steps__title">{{ section.settings.heading | escape }}</h2>

    <ol class="sc-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="sc-card sc-bounce sc-steps__card" {{ block.shopify_attributes }}>
          <span class="sc-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <div class="sc-steps__art">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(min-width: 750px) 300px, 90vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: ''
              }}
            {%- else -%}
              {%- capture art_label -%}Illustration {{ forloop.index }}{%- endcapture -%}
              {% render 'splashy-placeholder', label: art_label, hint: 'Pick an image in this step' %}
            {%- endif -%}
          </div>
          <h3 class="sc-steps__heading">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="sc-steps__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .sc-steps {
    background: var(--sc-sky);
    border-block: var(--sc-outline) solid var(--sc-ink);
  }

  .sc-steps__title {
    text-align: center;
  }

  .sc-steps__list {
    display: grid;
    gap: 28px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .sc-steps__card {
    position: relative;
    display: grid;
    gap: 12px;
    text-align: center;
  }

  .sc-steps__num {
    position: absolute;
    inset-block-start: -18px;
    inset-inline-start: -10px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: var(--sc-outline) solid var(--sc-ink);
    border-radius: 50%;
    background: var(--sc-orange);
    font-family: var(--sc-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .sc-steps__art {
    aspect-ratio: 4 / 3;
  }

  .sc-steps__art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sc-steps__heading {
    margin: 0;
    font-size: 1.5rem;
  }

  .sc-steps__text {
    margin: 0;
    line-height: 1.45;
  }

  @media (min-width: 750px) {
    .sc-steps__list {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy how it works",
  "class": "sc-steps-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splashy how it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Tighten it on",
            "text": "The mount comes fully assembled. Tighten it onto your gun once and leave it there."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Drop your phone in",
            "text": "Open the free Splashy Cam app. Scan the QR code in the box to get it."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Aim, hit, send",
            "text": "If you’re on target, it’s on video. Send the stamped clip to your host."
          }
        }
      ]
    }
  ]
}
{% endschema %}
