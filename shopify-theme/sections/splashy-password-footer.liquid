{% comment %}
  Section contract.
  Small footer for the pre-launch (password) page: Instagram link, plus the
  "Enter using password" button and admin link so the owner can still get in.
  Rendered statically by layout/password.liquid; the button opens the
  #password-form dialog that layout owns.
  @example
  <!-- Password page footer > Splashy password footer -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

<div class="sc-pfooter">
  {%- if section.settings.instagram_handle != blank -%}
    {%- assign ig = section.settings.instagram_handle | remove: '@' | strip -%}
    <a class="sc-pfooter__ig" href="https://www.instagram.com/{{ ig | url_encode }}/" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
      </svg>
      <span>@{{ ig | escape }}</span>
    </a>
  {%- endif -%}

  <div class="sc-pfooter__owner">
    <button class="button-unstyled sc-pfooter__enter" type="button" on:click="#password-form/showDialog">
      {{- 'actions.enter_using_password' | t -}}
    </button>
    <span aria-hidden="true">·</span>
    <span class="sc-pfooter__admin">{{ 'content.store_owner_link_html' | t: link: '/admin' }}</span>
  </div>
</div>

{% stylesheet %}
  .sc-pfooter {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 28px 16px 36px;
    background: var(--sc-ink);
    color: var(--sc-cream);
    text-align: center;
  }

  .sc-pfooter__ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 18px;
    border: var(--sc-outline) solid var(--sc-cream);
    border-radius: 999px;
    color: var(--sc-cream);
    font-family: var(--sc-display);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .sc-pfooter__ig:focus-visible,
  .sc-pfooter__enter:focus-visible {
    outline: 3px solid var(--sc-sky);
    outline-offset: 3px;
  }

  .sc-pfooter__owner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 10px;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .sc-pfooter__enter {
    min-height: 44px;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .sc-pfooter__admin a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy password footer",
  "class": "sc-pfooter-section",
  "settings": [
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "splashycam.shop" }
  ]
}
{% endschema %}
