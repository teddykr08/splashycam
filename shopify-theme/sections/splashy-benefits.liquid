{% comment %}
  Section contract.
  "What it does for you": benefit cards (Benefit blocks), each with an illustration
  slot (or a labeled placeholder), a short title and a line of text.
  @example
  <!-- Home page > Splashy benefits, with four Benefit blocks -->
{% endcomment %}

{% render 'splashy-ui-styles' %}

<div class="sc-section sc-benefits">
  <div class="sc-wrap">
    <h2 class="sc-title sc-benefits__title">{{ section.settings.heading | escape }}</h2>

    <ul class="sc-benefits__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="sc-card sc-bounce sc-benefits__card" {{ block.shopify_attributes }}>
          <div class="sc-benefits__art">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  widths: '200, 300, 400',
                  sizes: '(min-width: 750px) 200px, 40vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: ''
              }}
            {%- else -%}
              {%- capture art_label -%}Illustration: {{ block.settings.title }}{%- endcapture -%}
              {% render 'splashy-placeholder', label: art_label, hint: 'Pick an image in this benefit' %}
            {%- endif -%}
          </div>
          <div class="sc-benefits__copy">
            <h3 class="sc-benefits__heading">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="sc-benefits__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .sc-benefits__title {
    text-align: center;
  }

  .sc-benefits__grid {
    display: grid;
    gap: 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .sc-benefits__card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    align-items: center;
    padding: 16px;
  }

  .sc-benefits__art {
    aspect-ratio: 1;
  }

  .sc-benefits__art .sc-placeholder {
    min-height: 0;
    padding: 4px;
    border-radius: calc(var(--sc-radius) * 0.6);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .sc-benefits__art .sc-placeholder small {
    display: none;
  }

  .sc-benefits__art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sc-benefits__copy {
    min-width: 0;
  }

  .sc-benefits__heading {
    margin: 0 0 4px;
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .sc-benefits__text {
    margin: 0;
    line-height: 1.45;
  }

  @media (min-width: 750px) {
    .sc-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }

    .sc-benefits__card {
      grid-template-columns: 1fr;
      padding: 24px;
      text-align: center;
    }

    .sc-benefits__art {
      width: 160px;
      margin-inline: auto;
    }

    .sc-benefits__art .sc-placeholder small {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Splashy benefits",
  "class": "sc-benefits-section",
  "max_blocks": 6,
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Never miss the shot" }],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Illustration" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splashy benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Aim once, film both", "text": "The camera points where your gun points. If you’re on target, you’re recording." } },
        { "type": "benefit", "settings": { "title": "Your target and you", "text": "One clip shows who you hit and that it was you. No more he-said, she-said." } },
        { "type": "benefit", "settings": { "title": "Eyes on the chase", "text": "Stop juggling a phone. Focus on aiming and running, not on where the camera is pointing." } },
        { "type": "benefit", "settings": { "title": "Stamped with the time", "text": "The free app puts the time and a code on every clip, ready to send to your host." } }
      ]
    }
  ]
}
{% endschema %}
